<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../signing.props" />

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net6.0</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(IsWindows)' == 'true' ">
    <TargetFrameworks>$(TargetFrameworks);net462</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>MassTransit</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>MassTransit.NHibernate</PackageId>
    <Title>MassTransit.NHibernate</Title>
    <PackageTags>MassTransit;NHibernate</PackageTags>
    <Description>MassTransit NHibernate persistence support; $(Description)</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="NHibernateIntegration\Outbox\InboxState.hbm.xml" />
    <None Remove="NHibernateIntegration\Outbox\OutboxMessage.hbm.xml" />
    <None Remove="NHibernateIntegration\Outbox\OutboxState.hbm.xml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="NHibernateIntegration\Outbox\InboxState.hbm.xml" />
    <EmbeddedResource Include="NHibernateIntegration\Outbox\OutboxMessage.hbm.xml" />
    <EmbeddedResource Include="NHibernateIntegration\Outbox\OutboxState.hbm.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Iesi.Collections" />
    <PackageReference Include="NHibernate" />
	<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
	<ProjectReference Include="..\..\MassTransit\MassTransit.csproj" />
  </ItemGroup>

</Project>
