<?xml version="1.0" encoding="utf-8" ?>

<hibernate-mapping
    xmlns="urn:nhibernate-mapping-2.2"
    assembly="MassTransit.NHibernateIntegration"
    namespace="MassTransit.NHibernateIntegration.Outbox">

  <class name="InboxState"
         table="InboxState">

    <id name="Id">
      <generator class="assigned"/>
    </id>

    <version name="Version"
             column="Version"
             unsaved-value="0" />

    <property name="MessageId" />
    <property name="ConsumerId" />
    <property name="LockId" />
    <property name="Received" />
    <property name="ReceiveCount" />
    <property name="ExpirationTime" />
    <property name="Consumed" />
    <property name="Delivered" />
    <property name="LastSequenceNumber" />

    <natural-id>
      <property name="MessageId" />
      <property name="ConsumerId" />
    </natural-id>

  </class>

</hibernate-mapping>
